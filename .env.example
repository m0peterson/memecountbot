# ─────────────────────────────────────────────────────────────
#  REQUIRED
# ─────────────────────────────────────────────────────────────

# Token from @BotFather (https://t.me/BotFather -> /newbot)
BOT_TOKEN=123456:ABC-DEF_your_token_here

# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ─────────────────────────────────────────────────────────────
#  COUNTING
# ─────────────────────────────────────────────────────────────

# Memes allowed per person per day. The warning fires on meme number DAILY_LIMIT + 1.
DAILY_LIMIT=5

# IANA timezone that decides when "a day" rolls over (counters reset at midnight here).
TIMEZONE=Europe/Moscow

# true  = warn a person once per day, then stop looking at their messages until tomorrow
# false = reply to every meme past the limit
WARN_ONCE_PER_DAY=true

# ─────────────────────────────────────────────────────────────
#  WHAT THE BOT LOOKS AT
# ─────────────────────────────────────────────────────────────

# Photos, stickers, GIFs and image files are always examined.
# Plain text messages (jokes, copypasta) — costs one LLM call per message.
CHECK_TEXT=true

# Ignore text shorter than this many characters ("ок", "+1", emoji…).
MIN_TEXT_LEN=12

# Also look at video thumbnails. Off by default: videos are usually not memes.
CHECK_VIDEO=false

# Treat every sticker as a meme without asking the LLM (cheaper, blunter).
COUNT_STICKERS_AS_MEMES=false

# ─────────────────────────────────────────────────────────────
#  LLM
# ─────────────────────────────────────────────────────────────

# Must be a vision-capable model. Cheap options that work well:
#   google/gemini-2.5-flash        (default, good quality/price)
#   google/gemini-2.5-flash-lite   (cheapest)
#   openai/gpt-4o-mini
#   qwen/qwen2.5-vl-72b-instruct
OPENROUTER_MODEL=google/gemini-2.5-flash

# How sure the model has to be before a message counts as a meme (0.0–1.0).
MIN_CONFIDENCE=0.6

# ─────────────────────────────────────────────────────────────
#  THE REPLY
# ─────────────────────────────────────────────────────────────

# What to send when someone goes over the limit. Can be:
#   a local file   assets/warning.jpg   (put your screenshot there)
#   a URL          https://example.com/warning.jpg
#   a Telegram file_id of an already-uploaded photo/sticker/GIF
# If the file is missing, the bot replies with WARNING_TEXT instead.
WARNING_FILE=assets/warning.jpg

# auto = guess from the file extension. Force with: photo | sticker | animation | video | document | text
WARNING_TYPE=auto

# Fallback text (also used as a caption when SEND_WARNING_CAPTION=true).
WARNING_TEXT=Россияне, которые скидывают мемы в общие чаты, работают хуже всех, заявили аналитики «Стахановца». Те, кто отправляет более пяти нерабочих сообщений в день, показывают снижение эффективности на 27% относительно коллег.

SEND_WARNING_CAPTION=false

# ─────────────────────────────────────────────────────────────
#  OPTIONAL
# ─────────────────────────────────────────────────────────────

# Only work in these chats (comma-separated chat ids). Empty = every chat it is added to.
ALLOWED_CHATS=

# Extra users who may run /memereset besides chat admins.
ADMIN_IDS=

# Turn off /memestats, /memereset, /memehelp for a fully silent bot.
ENABLE_COMMANDS=true

# Where the SQLite file lives.
DB_PATH=data/memecount.db

# Set by hosting platforms that require an open port (Render/Railway web services).
# Leave empty for Docker/VPS — no port is needed.
PORT=

LOG_LEVEL=INFO
